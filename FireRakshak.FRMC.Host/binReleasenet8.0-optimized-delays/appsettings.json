{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Dts": {
    "IpAddress": "127.0.0.1",
    "Port": 3001,
    "ConnectionRetryPeriod": "00:05:00"
  },

  "RS232": {
    "PortName": "COM4",
    "BaudRate": 115200,
    "Parity": "None",
    "DataBits": 8,
    "StopBits": "One"
  },

  "NetworkAdapters": {
    "Port1": "Ethernet 1",
    "Port2": "Ethernet 2"
  },

  "SystemSettings": {
    "EnableClockConfiguration": true,
    "ClockSettings": {
      "UseDummy": true
    },
    "DisableNetworkTimeSync": false
  },

  "SimulateConfigurationChanges": {
    "Clock": true,
    "Ip": true
  },

  "ModbusServer": {
    "Port": 502
  },

  "WebSocketServers": {
    "AuthenticatedPort": 6164,
    "PublicPort": 5002
  },

  "Jwt": {
    "Secret": "your_super_secret_jwt_key_that_is_at_least_32_characters_long"
  },

  "BackgroundServices": {
    "DtsBackgroundServiceEnabled": true,
    "DtsHealthBackgroundServiceEnabled": true,
    "AlarmPublisherServiceEnabled": true
  },

